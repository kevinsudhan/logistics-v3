node_modules
dist
*.tsbuildinfo

# Secrets. .env.local carries the anon key and the feature flags.
.env
.env.*

# Local fallback store, used only when Supabase is unreachable. Holds real customer
# names and phone numbers captured from actual calls — genuine PII, never committed.
# Supabase is the system of record; this file is a cache.
/data/

# Generated document samples — regenerable from scripts/generate-sample-documents.mjs,
# so the PDFs are evidence rather than source.
sample-documents/

# v2 Supabase service_role key and db password — bypasses RLS, never commit.
server-v2/.keys.json
server-v2/.project.json
server-v2/.azure.json
server-v2/.snapserve.json
server-v2/.vaishnavi-identity-backup.json
server-v2/.vaishnavi-glitch-backup.json

# Supabase CLI scratch. There is no supabase/ directory here any more — v2's
# schema is supabase-v2/ — but the rule stays: running the CLI in this folder
# recreates it, and the linked-project file it writes was once committed pinned
# to v1, the project shared with the live voice agents.
supabase/.temp/
