                    ],
                    "properties": {
                      "cinTyp": {
                        "type": "string",
                        "description": "The Type of Cargo Identification Number given by Customs for referenced Cargo",
                        "minLength": 0,
                        "maxLength": 4
                      },
                      "mcinPcin": {
                        "type": "string",
                        "description": "The unique Identifier issued by Customs for Transport Contract issued by Main line operator- Master Cargo Identification Number",
