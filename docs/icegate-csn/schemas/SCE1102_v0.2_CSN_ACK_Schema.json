      "properties": {
        "startSignature": {
          "type": "string",
          "description": "Start Signature"
        },
        "startCertificate": {
          "type": "string",
          "description": "Start Certificate"
        },
        "signerVersion": {
          "type": "string",
          "description": "Signer Version"
        }
