                          "$ref": "#/definitions/errCD"
                        }
                      },
                      "Amend_det": {
                        "$ref": "#/definitions/Amend_det"
                      }
                    }
                  },
                  "trnsprtDoc": {
                    "type": "object",
                    "description": "The Details of Document issued by Main Transport Operator",
                    "properties": {
                      "trnsprtDocErrorCode": {
                        "type": "array",
                        "errCD": {
                          "$ref": "#/definitions/errCD"
                        }
                      },
                      "Amend_det": {
                        "$ref": "#/definitions/Amend_det"
                      }
                    }
                  },
                  "trnsprtDocMsr": {
                    "type": "object",
                    "description": "The Details of Document issued by NVOCC",
                    "properties": {
                      "trnsprtDocmsrErrorCode": {
                        "type": "array",
                        "errCD": {
                          "$ref": "#/definitions/errCD"
                        }
                      },
                      "Amend_det": {
                        "$ref": "#/definitions/Amend_det"
                      }
                    }
                  },
                  "itemDtls": {
                    "type": "array",
                    "description": "The Details of Cargo items in reference to Transport Document",
                    "items": {
                      "type": "object",
                      "required": [
                        "crgoItemSeqNmbr"
                      ],
                      "properties": {
                        "crgoItemSeqNmbr": {
                          "type": "number",
                          "description": "The Serial number indicating the cargo items carried in the Transport Document",
                          "minimum": 1.0,
                          "maximum": 99999.0
                        },
                        "itemDtlsErrorCode": {
                          "type": "array",
                          "errCD": {
                            "$ref": "#/definitions/errCD"
                          }
                        },
                        "Amend_det": {
                          "$ref": "#/definitions/Amend_det"
                        }
                      }
                    },
                    "trnsprtEqmt": {
                      "type": "array",
                      "description": "The Details of Transport Equipment referenced in Transport Document",
                      "items": {
                        "type": "object",
                        "required": [
                          "eqmtSeqNo"
                        ],
                        "properties": {
                          "eqmtSeqNo": {
                            "type": "string",
                            "description": "The Serial number of Equipment referenced in the Transport Document",
                            "minimum": 1.0,
                            "maximum": 99999.0
                          },
                          "trnsprtEqpmtErrorCode": {
                            "type": "array",
                            "errCD": {
                              "$ref": "#/definitions/errCD"
                            }
                          },
                          "Amend_det": {
                            "$ref": "#/definitions/Amend_det"
                          }
                        }
                      }
                    },
                    "itnry": {
                      "type": "array",
                      "description": "The Details of Routing for the referenced Cargo",
                      "items": {
                        "type": "object",
                        "description": "An explanation about the purpose of this instance.",
                        "required": [
                          "prtOfCallSeqNmbr"
                        ],
                        "properties": {
                          "prtOfCallSeqNmbr": {
                            "type": "number",
                            "description": "The Serial number indicating the sequence of the port of call by the referenced cargo",
                            "minimum": 1.0,
                            "maximum": 99999.0
                          },
                          "itnryErrorCode": {
                            "type": "array",
                            "errCD": {
                              "$ref": "#/definitions/errCD"
                            }
                          },
                          "Amend_det": {
                            "$ref": "#/definitions/Amend_det"
                          }
                        }
                      }
                    },
                    "houseCargoDec": {
                      "type": "array",
                      "description": "Nil Cargo Ships can come",
                      "items": {
                        "type": "object",
                        "required": [
                          "HCRef",
                          "trnsprtDocMsr"
                        ],
                        "properties": {
                          "HCRef": {
                            "type": "object",
                            "description": "The Details of House Transport Document",
                            "required": [
                              "subLineNo"
                            ],
                            "properties": {
                              "subLineNo": {
                                "type": "number",
                                "description": "The Serial number of the House Transport Document",
                                "minimum": 1.0,
                                "maximum": 9999.0
                              },
                              "HCRefErrorCode": {
                                "type": "array",
                                "errCD": {
                                  "$ref": "#/definitions/errCD"
                                }
                              },
                              "Amend_det": {
                                "$ref": "#/definitions/Amend_det"
                              }
                            },
                            "prevRef": {
                              "type": "object",
                              "description": "The Details of Reference to declaration filed earlier for this cargo",
                              "prevRefErrorCode": {
                                "type": "array",
                                "errCD": {
                                  "$ref": "#/definitions/errCD"
                                }
                              },
                              "Amend_det": {
                                "$ref": "#/definitions/Amend_det"
                              }
                            }
                          },
                          "locCstm": {
                            "type": "object",
                            "description": "The Details of locations relevant for this House Transport Document ",
                            "locCstmErrorCode": {
                              "type": "array",
                              "errCD": {
                                "$ref": "#/definitions/errCD"
                              }
                            },
                            "Amend_det": {
                              "$ref": "#/definitions/Amend_det"
                            }
                          }
                        },
                        "trnshpr": {
                          "type": "object",
                          "description": "The Details of Authorised Person undertaking responsibility of Transhipment",
                          "properties": {
                            "trnshprErrorCode": {
                              "type": "array",
                              "errCD": {
                                "$ref": "#/definitions/errCD"
                              }
                            },
                            "Amend_det": {
                              "$ref": "#/definitions/Amend_det"
                            }
                          }
                        },
                        "trnsprtDoc": {
                          "type": "object",
                          "description": "The Details of Document issued by NVOCC",
                          "properties": {
                            "trnsprtDocErrorCode": {
                              "type": "array",
                              "errCD": {
                                "$ref": "#/definitions/errCD"
                              }
                            },
                            "Amend_det": {
                              "$ref": "#/definitions/Amend_det"
                            }
                          }
                        },
                        "trnsprtDocMsr": {
                          "type": "object",
                          "description": "The Details of Document issued by NVOCC",
                          "properties": {
                            "trnsprtDocmsrErrorCode": {
                              "type": "array",
                              "errCD": {
                                "$ref": "#/definitions/errCD"
                              }
                            },
                            "Amend_det": {
                              "$ref": "#/definitions/Amend_det"
                            }
                          }
                        },
                        "itemDtls": {
                          "type": "array",
                          "description": "The Details of Cargo items in reference to Transport Document",
                          "items": {
                            "type": "object",
                            "required": [
                              "crgoItemSeqNmbr"
                            ],
                            "properties": {
                              "crgoItemSeqNmbr": {
                                "type": "number",
                                "description": "The Serial number indicating the cargo items carried in the Transport Document",
                                "minimum": 1.0,
                                "maximum": 99999.0
                              },
                              "itemDtlsErrorCode": {
                                "type": "object",
                                "errCD": {
                                  "$ref": "#/definitions/errCD"
                                }
                              },
                              "Amend_det": {
                                "$ref": "#/definitions/Amend_det"
                              }
                            }
                          }
                        },
                        "trnsprtEqmt": {
                          "type": "array",
                          "description": "The Details of Transport Equipment referenced in Transport Document",
                          "items": {
                            "type": "object",
                            "required": [
                              "eqmtSeqNo"
                            ],
                            "properties": {
                              "eqmtSeqNo": {
                                "type": "number",
                                "description": "The Serial number of Equipment referenced in the Transport Document",
                                "minimum": 1.0,
                                "maximum": 99999.0
                              },
                              "trnsprtEqpmtErrorCode": {
                                "type": "array",
                                "errCD": {
                                  "$ref": "#/definitions/errCD"
                                }
                              },
                              "Amend_det": {
                                "$ref": "#/definitions/Amend_det"
                              }
                            }
                          }
                        },
                        "itnry": {
                          "type": "array",
                          "description": "The Details of Routing for the referenced Cargo",
                          "items": {
                            "type": "object",
                            "description": "An explanation about the purpose of this instance.",
                            "required": [
                              "prtOfCallSeqNmbr"
                            ],
                            "properties": {
                              "prtOfCallSeqNmbr": {
                                "type": "number",
                                "description": "The Serial number indicating the sequence of the port of call by the referenced cargo",
                                "minimum": 1.0,
                                "maximum": 99999.0
                              },
                              "itnryErrorCode": {
                                "type": "array",
                                "errCD": {
                                  "$ref": "#/definitions/errCD"
                                }
                              },
