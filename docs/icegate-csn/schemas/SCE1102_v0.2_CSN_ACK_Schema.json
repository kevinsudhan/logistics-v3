{
  "definitions": {
    "errCD": {
      "type": "array",
      "properties": {
        "pathName": {
          "type": "string"
        },
        "errorCode": {
          "type": "string"
        },
        "errorMessage": {
          "type": "string"
        }
      }
    },
    "Amend_det": {
      "type": "string",
      "description": "The date of Amendment.",
      "format": "date"
    }
  },
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "versionNo": "SCE1102",
  "description": "An explanation about the purpose of this instance.",
  "required": [
    "headerField",
    "master",
    "digSign"
  ],
  "properties": {
    "headerField": {
      "type": "object",
      "description": "Header Field",
      "required": [
        "senderID",
        "receiverID",
        "versionNo",
        "indicator",
        "messageID",
        "sequenceOrControlNumber",
        "date",
        "time",
        "reportingEvent"
      ],
      "properties": {
        "senderID": {
          "type": "string",
          "description": "ICEGATE ID",
          "minLength": 1,
          "maxLength": 30
        },
        "receiverID": {
          "type": "string",
          "description": "ICEGATE code of Sea Manifest",
          "minLength": 1,
          "maxLength": 30
        },
        "versionNo": {
          "type": "string",
          "description": "ICEGATE version being used",
          "minLength": 1,
          "maxLength": 7
        },
        "indicator": {
          "type": "string",
          "description": "test (T) or production (P) indicator",
          "minLength": 1,
          "maxLength": 1
        },
        "messageID": {
          "type": "string",
          "description": "message name",
          "minLength": 1,
          "maxLength": 7
        },
        "sequenceOrControlNumber": {
          "type": "string",
          "description": "unique value that can be used to uniquely identify the document",
         "minLength": 1,
          "maxLength": 7
        },
        "date": {
          "type": "string",
          "description": "Date of transmission of message",
          "pattern": "^[0-9]{4}[(0[1-9]|1[0-2]]{2}[(0[1-9]|[1-2][0-9]|3[0-1]]{2}]$"
        },
        "time": {
          "type": "string",
          "description": "Time of transmission of message",
          "pattern": "^[T]([01]?[0-9]|2[0-3]):[0-5][0-9]$"
        },
        "reportingEvent": {
          "type": "string",
          "description": "Reporting Event",
          "minLength": 1,
          "maxLength": 4
        }
      }
    },
    "master": {
      "type": "object",
      "description": "Master",
      "required": [
        "decRef"
      ],
      "properties": {
        "decRef": {
          "type": "object",
          "required": [
            "msgTyp",
            "prtofRptng",
            "jobNo",
            "jobDt",
            "rptngEvent"
          ],
          "properties": {
            "msgTyp": {
              "type": "string",
              "description": "The Flag specifying the  action requested on this transmission",
              "minLength": 1,
              "maxLength": 1
            },
            "prtofRptng": {
              "type": "string",
              "description": "The Custom Location of Reporting",
              "pattern": "([I][N])([A-Z]|[0-9]){4}$",
              "minLength": 5,
              "maxLength": 10
            },
            "jobNo": {
              "type": "string",
              "description": "The Unique ID provided by User for this transmission",
              "minimum": 1.0,
              "maximum": 9999999.0
            },
            "jobDt": {
              "type": "string",
              "pattern": "^[0-9]{4}[(0[1-9]|1[0-2]]{2}[(0[1-9]|[1-2][0-9]|3[0-1]]{2}]$",
              "description": "The Date of generation of of Unique ID provided by User for this transmission"
            },
            "rptngEvent": {
              "type": "string",
              "description": "The Code specifying the Reporting Event pertaining to this transmission,list of values, which will be accepted SAM,SDM,SAA,SEI,SDN",
              "minLength": 1,
              "maxLength": 4
            },
            "csn_no": {
              "type": "number",
              "description": "The Unique ID generated by Customs for this Complaince",
              "minimum": 0.0,
              "maximum": 9999999.0
            },
            "csn_dt": {
              "type": "string",
              "description": "The Date generation of Unique ID by Customs for  this Compliance",
              "pattern": "^[0-9]{4}[(0[1-9]|1[0-2]]{2}[(0[1-9]|[1-2][0-9]|3[0-1]]{2}]$"
            },
            "decRefErrorCode": {
              "type": "array",
              "description": "error code",
              "errCD": {
                "$ref": "#/definitions/errCD"
              }
            },
            "Amend_det": {
              "$ref": "#/definitions/Amend_det"
            }
          }
        },
        "authPrsnErrorCode": {
          "type": "array",
          "description": "The Details of Authorised person responsible as per Customs legislation",
          "properties": {
            "errCD": {
              "$ref": "#/definitions/errCD"
            },
            "Amend_det": {
              "$ref": "#/definitions/Amend_det"
            }
          }
        },
        "vesselDtlsErrorCode": {
          "type": "array",
          "description": "The Details of Conveyance",
          "properties": {
            "errCD": {
              "$ref": "#/definitions/errCD"
            },
            "Amend_det": {
              "$ref": "#/definitions/Amend_det"
            }
          }
        },
        "voyageDtlsErrorCode": {
          "type": "array",
          "description": "The details of Voyage/Trip of the conveyance",
          "properties": {
            "errCD": {
              "$ref": "#/definitions/errCD"
            },
            "Amend_det": {
              "$ref": "#/definitions/Amend_det"
            }
          },
          "mastrCnsgmtDec": {
            "type": "array",
            "description": "The Details pertaining to Transport Documents carried in the conveyance. ",
            "required": [
              "MCRef",
              "trnsprtDocMsr"
            ],
            "items": {
              "type": "object",
              "properties": {
                "MCRef": {
                  "type": "object",
                  "description": "The Reference of Master Consignment",
                  "required": [
                    "lineNo"
                  ],
                  "properties": {
                    "lineNo": {
                      "type": "number",
                      "description": "The serial number indicating the list of Transport Contracts carried in the Transport Means",
                      "minimum": 1.0,
                      "maximum": 99999.0
                    },
                    "MCRefErrorCode": {
                      "type": "array",
                      "errCD": {
                        "$ref": "#/definitions/errCD"
                      }
                    },
                    "Amend_det": {
                      "$ref": "#/definitions/Amend_det"
                    }
                  }
                },
                "prevRef": {
                  "type": "object",
                  "description": "The Details of Reference to declaration filed earlier for this cargo",
                  "properties": {
                    "prevRefErrorCode": {
                      "type": "array",
                      "errCD": {
                        "$ref": "#/definitions/errCD"
                      }
                    },
                    "Amend_det": {
                      "$ref": "#/definitions/Amend_det"
                    }
                  },
                  "locCstm": {
                    "type": "object",
                    "description": "The Details of Relevant of Port of Call pertaining to this cargo",
                    "properties": {
                      "locCstmErrorCode": {
                        "type": "array",
                        "errCD": {
                          "$ref": "#/definitions/errCD"
                        }
                      },
                      "Amend_det": {
                        "$ref": "#/definitions/Amend_det"
                      }
                    }
                  },
                  "trnshpr": {
                    "type": "object",
                    "description": "The Details of Authorised Person undertaking responsibility of Transhipment",
                    "properties": {
                      "trnshprErrorCode": {
                        "type": "array",
