                            "minLength": 0,
                            "maxLength": 4
                          },
                          "mcinPcin": {
                            "type": "string",
                            "description": "The unique Identifier issued by Customs for Transport Contract issued by Main line operator- Master Cargo Identification Number",
                            "minLength": 0,
                            "maxLength": 20
                          }
                        }
                      }
                    }
                  },
                  "mcSuprtDocs": {
                    "type": "array",
                    "description": "The Details of Supporting Documents provided in reference to the cargo in Transport Document",
                    "items": {
                      "type": "object",
                      "required": [
                        "tagRef",
                        "refSerialNo",
                        "subSerialNoRef"
                      ],
                      "properties": {
                        "tagRef": {
                          "type": "string",
                          "description": "The Flag indicating the part of the declaration to which this document is referenced",
                          "minLength": 1,
                          "maxLength": 5
                        },
